rules_version = '2';

// ⚠️ 本地 emulator 專用的最小可跑規則，允許任何讀寫。這份檔案同時是
// `firebase.json` 的 firestore.rules 部署來源，**在正式環境的白名單學校
// key / increment 上限規則落地之前，不可對 haikyuu-cards-cloud 執行
// `firebase deploy --only firestore`**（會讓正式 Firestore 變成匿名可
// 讀寫）。只在本地 `firebase emulators:start`/`emulators:exec` 使用。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
